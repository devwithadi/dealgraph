# Bedrock authentication: configure this token or another explicit AWS source
# (access-key pair, profile, web identity, or container credentials).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# AWS Bedrock Models
BEDROCK_SCREENING_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

DEALGRAPH_LOOKBACK_DAYS=30

# OpenAI Models
OPENAI_SCREENING_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4.1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
