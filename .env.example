# Bedrock is the default online narrative provider. Boto3 uses the standard AWS
# credential chain (environment, shared profile, or workload role).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# OpenAI is selected with --provider openai. Custom endpoints must be public HTTPS on port 443.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
