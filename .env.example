# Bedrock authentication: set this for an AWS Bedrock API key, or omit it and
# use the standard AWS credential chain (profile, IAM role, or temporary creds).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Any text-generation model/profile supporting Bedrock Converse system prompts.
BEDROCK_SCREENING_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

DEALGRAPH_LOOKBACK_DAYS=30

# Optional OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SCREENING_MODEL=gpt-4.1-nano
OPENAI_MODEL=gpt-4.1-mini
